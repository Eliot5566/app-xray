{
  "name": "app-xray",
  "version": "0.1.0",
  "description": "An ingredients and privacy label for any app, built on REA (Reverse Engineer Anything).",
  "keywords": [
    "electron",
    "apk",
    "privacy",
    "security",
    "sbom",
    "reverse-engineering",
    "rea",
    "static-analysis",
    "gguf",
    "pickle"
  ],
  "homepage": "https://eliot5566.github.io/app-xray/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eliot5566/app-xray.git"
  },
  "bugs": {
    "url": "https://github.com/Eliot5566/app-xray/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "app-xray": "dist/cli.js",
    "xray": "dist/cli.js",
    "rea-bench": "dist/bench/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "data"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "xray": "node dist/cli.js",
    "bench": "npm run build && node bench/run-corpus.mjs",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "rea-agents": "6.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
